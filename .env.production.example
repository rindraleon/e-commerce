# Domaine public
DOMAIN_NAME=shop.monsite.com
ACME_EMAIL=admin@monsite.com
FRONTEND_URL=https://shop.monsite.com
CORS_ALLOWED_ORIGINS=https://shop.monsite.com
VITE_SITE_URL=https://shop.monsite.com
VITE_API_BASE_URL=/api
VITE_API_PREFIX=

# Sécurité / application
JWT_SECRET=change_this_secret_to_a_long_random_value
TRUST_PROXY=true
THROTTLE_TTL=60
THROTTLE_LIMIT=120
AUTH_THROTTLE_TTL=60
AUTH_THROTTLE_LIMIT=10
ENABLE_DEFAULT_ADMIN=false
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=
DEFAULT_ADMIN_FULL_NAME=Administrateur

# Base PostgreSQL
POSTGRES_DB=eshop
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_this_database_password
DB_SSL=false

# Email SMTP (optionnel)
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=no-reply@shop.monsite.com
